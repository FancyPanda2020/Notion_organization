# Notion API
# Créer une intégration sur : https://www.notion.so/my-integrations
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_PARENT_PAGE_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Calendar API (optionnel)
# Guide: https://developers.google.com/calendar/api/quickstart/python
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json

# Strava API (optionnel)
# Créer une app sur : https://www.strava.com/settings/api
STRAVA_CLIENT_ID=XXXXX
STRAVA_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRAVA_REFRESH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Configuration
TIMEZONE=Europe/Paris
